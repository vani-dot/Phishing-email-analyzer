# Phishing Email Analyzer — configuration
#
# Copy to .env and edit. Everything here has a safe default; the file only
# exists to loosen or point things elsewhere.
#
#   cp .env.example .env

# ---- AI layer (optional) --------------------------------------------------
# The analyser is fully functional without this. With no key it runs
# rules-only: deterministic, reproducible, offline. A key adds a reading of
# the language on top — it never overrides the technical evidence.
#
# TWO PROVIDERS, TRIED IN ORDER. The fallback is used when the primary times
# out, rate-limits, returns 5xx, or answers with something that will not
# validate. Free tiers run out; this keeps the AI layer alive instead of
# silently dropping to rules-only mid-demo. The report names whichever
# provider answered.
#
# Any OpenAI-compatible provider works. No vendor SDK, so swapping is config:
#
#   Groq        https://api.groq.com/openai/v1    openai/gpt-oss-120b
#   apmix       https://api.apmix.ai/v1           gpt-5.6-luna-free
#   OpenRouter  https://openrouter.ai/api/v1      meta-llama/llama-3.3-70b-instruct
#   Ollama      http://localhost:11434/v1         llama3.1:8b
#
PEA_LLM_ENABLED=true

PEA_LLM_PROVIDER=groq
PEA_LLM_API_KEY=
PEA_LLM_BASE_URL=https://api.groq.com/openai/v1
PEA_LLM_MODEL=openai/gpt-oss-120b

PEA_LLM_FALLBACK_PROVIDER=apmix
PEA_LLM_FALLBACK_API_KEY=
PEA_LLM_FALLBACK_BASE_URL=https://api.apmix.ai/v1
PEA_LLM_FALLBACK_MODEL=gpt-5.6-luna-free

PEA_LLM_TIMEOUT=45
PEA_LLM_MAX_BODY_CHARS=4000

# ---- server ---------------------------------------------------------------
PEA_HOST=127.0.0.1
PEA_PORT=8000
# Verbose errors and the /docs page. Never enable in production.
PEA_DEBUG=false
# Set true when serving over HTTPS. Marks cookies Secure and enables HSTS.
PEA_HTTPS=false

# ---- sessions -------------------------------------------------------------
PEA_SESSION_IDLE_MINUTES=30
PEA_SESSION_ABSOLUTE_HOURS=12
# Generated and persisted to data/.secret_key on first run if left blank.
PEA_SECRET_KEY=

# ---- first-run account ----------------------------------------------------
# Default credentials, created once on an empty database. Convenient for a
# demo, and a full admin handover to anyone who can reach the port — so keep
# PEA_HOST on 127.0.0.1 while these are in use.
#
# Leave PEA_DEFAULT_PASSWORD blank to generate a random password instead and
# print it once at first startup.
PEA_DEFAULT_USERNAME=Vani
PEA_DEFAULT_PASSWORD=Vani
PEA_DEFAULT_FORCE_CHANGE=false

# ---- passwords and lockout ------------------------------------------------
# Applies to every account created through the Users screen. The first-run
# account is created directly and is exempt, which is what lets the default
# above be four characters while everyone else needs twelve.
PEA_PASSWORD_MIN_LENGTH=12
PEA_MAX_FAILED_LOGINS=5
PEA_LOCKOUT_MINUTES=15
PEA_ARGON2_TIME_COST=3
PEA_ARGON2_MEMORY_KIB=65536
PEA_ARGON2_PARALLELISM=2

# ---- rate limits (requests per window) ------------------------------------
PEA_RATE_LOGIN=10
PEA_RATE_ANALYZE=30
PEA_RATE_GLOBAL=300

# ---- limits ---------------------------------------------------------------
PEA_MAX_UPLOAD_BYTES=2097152

# ---- outbound network (off by default) ------------------------------------
# Enabling URL expansion makes this server send requests to links found in
# analysed email — i.e. to attacker-controlled infrastructure. Every hop is
# SSRF-checked and nothing is ever rendered or executed, but it is still an
# outbound connection from your network, so it is an explicit choice.
PEA_ENABLE_URL_EXPANSION=false
PEA_ENABLE_DNS_CHECKS=false
PEA_URL_TIMEOUT=5
PEA_URL_MAX_HOPS=8
PEA_URL_MAX_EXPAND=10
PEA_DNS_TIMEOUT=3

# ---- storage --------------------------------------------------------------
# PEA_DB_PATH=data/analyzer.db
